# Base de datos PostgreSQL (local con docker compose o Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emprendetech"
# Auth.js (NextAuth): genere uno con `openssl rand -base64 32`
NEXTAUTH_SECRET="cambie-este-secreto"
NEXTAUTH_URL="http://localhost:3000"
# Secreto compartido con la pasarela para firmar el webhook
WEBHOOK_SECRET="secreto-webhook-de-prueba"
# URL pública de la app (la usa el simulador de Nequi para llamar al webhook)
APP_URL="http://localhost:3000"
